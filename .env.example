# Copy to .env. .env is gitignored - never commit real secrets.

APP_NAME=ocr-balance
APP_ENV=development
APP_TIMEZONE=Asia/Bangkok

DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database --------------------------------------------------------------
# PostgreSQL. This service owns only its own balance_* and django_* tables, so
# it can share a server with anything else. Point these at whichever server the
# backend uses; nothing in the code assumes a particular host or database.
#
# To run without PostgreSQL at all (local trial, demo), skip these and use
#   manage.py runserver --settings=config.settings.local_sqlite
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ocr_balance
DB_USER=postgres
DB_PASSWORD=
# disable | allow | prefer | require | verify-ca | verify-full.
# Production should use verify-full with a CA-signed server certificate.
DB_SSLMODE=prefer
DB_CONNECT_TIMEOUT=10
# Abort any single query that runs longer than this (milliseconds).
DB_STATEMENT_TIMEOUT_MS=60000
DB_CONN_MAX_AGE=0
# Integration tests; the name must differ from DB_NAME.
TEST_DB_NAME=ocr_balance_test

# --- API -------------------------------------------------------------------
# Origins allowed to call this service from a browser. A server-to-server
# caller (the Go backend) is not affected by this.
CORS_ALLOW_ORIGINS=http://localhost:3002,http://127.0.0.1:3002

# --- OCR -------------------------------------------------------------------
# Submitted documents are written under here, in input/.
DOCUMENT_ROOT=./data
# MUST NOT be "th": PaddleOCR 2.9.1 ships no Thai model and asserts on it.
# See docs/OCR_THAI.md.
OCR_LANGUAGE=latin
OCR_USE_GPU=false
# The grid-detection tolerances are calibrated at this dpi.
OCR_RENDER_DPI=200

BULK_INSERT_BATCH_SIZE=1000
LOG_LEVEL=INFO

# TLS trust for PaddleOCR's model download on a machine whose antivirus or proxy
# inspects TLS. Generate the bundle with: python scripts/setup_certs.py
REQUESTS_CA_BUNDLE=certs/ca-bundle.pem
